bool is_acked[MAX_SEQ];           // Tracks if packet 'i' is ACKed
int tmp_id;
// Helper to count how many frames are currently in flight/unacked
int count() {
    if (next_seq &gt;= base) return next_seq - base;
    else return (MAX_SEQ - base) + next_seq;
}
</declaration>
