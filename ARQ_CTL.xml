	<declaration>// Place global declarations here.
clock global_time;
// CONSTANTS
const int N = 4;              // Window Size
const int MAX_SEQ = 8;        // Sequence space size (Must be &gt;= 2*N)
const int LATENCY = 10;    // Network delay
const int TIMEOUT = 50;    // Retransmission timer
const int MAX_LOSS = 2;    // Bounded loss to pass liveness
const int TOTAL_LIMIT = 10;
// TYPES
typedef int[0, MAX_SEQ-1] id_t; // Packet ID type (0 to 7)

// CHANNELS

broadcast chan send_packet, deliver_packet;
broadcast chan send_ack, deliver_ack;
int[0, MAX_SEQ-1] msg_id; // Carries the Packet/ACK ID during synchronization
// Forward path: Sender -&gt; Medium -&gt; Receiver
//broadcast chan send_packet[id_t];
//broadcast chan deliver_packet[id_t];

// Return path: Receiver -&gt; Medium -&gt; Sender
//broadcast chan send_ack[id_t];
//broadcast chan deliver_ack[id_t];

// HELPER FUNCTIONS (Global)
// Checks if a sequence number 's' is within window [base, base+N)
bool inside_window(int base, int s) {
    int max = (base + N) % MAX_SEQ;
    if (max &lt;= MAX_SEQ) {
        return (s &gt;= base &amp;&amp; s &lt; max);
    } else {
        // Window wraps around MAX_SEQ
        return (s &gt;= base || s &lt; max);
    }
}
</declaration>
